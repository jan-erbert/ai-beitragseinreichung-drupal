{% set submission = message.params.submission %}
{% if is_html %}
<!DOCTYPE html>
<html lang="de"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ submission.event_label|default('Neue Beitragseinreichung') }}</title></head>
<body style="margin:0;background:#f4f6f8;color:#243746;font-family:Arial,Helvetica,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="24" cellspacing="0" style="width:100%;max-width:600px;table-layout:fixed;background:#fff;border:1px solid #dae2e8;border-radius:10px;overflow-wrap:anywhere;">
<tr><td style="padding:18px 20px;border-bottom:1px solid #dae2e8;"><img src="cid:je-ai-mail-header" alt="AI Beitragseinreichung – Jan Erbert – Web Development" width="560" style="display:block;width:100%;max-width:560px;height:auto;border:0;"></td></tr>
<tr><td><p style="color:#526777;">{{ submission.site }} · {{ submission.event_label|default('Neue Beitragseinreichung') }}</p><h1 style="font-size:28px;line-height:1.25;overflow-wrap:anywhere;">{{ submission.title }}</h1><p>{{ submission.intro|default('Dieser Beitrag wurde zur Prüfung eingereicht und ist noch nicht veröffentlicht.') }}</p>
{% if submission.featured %}<img src="cid:{{ submission.featured.cid }}" alt="{{ submission.featured.alt }}" width="552" style="display:block;width:100%;max-width:552px;height:auto;border:0;border-radius:6px;margin:16px 0;">{% endif %}
<table cellpadding="6" cellspacing="0" style="width:100%;font-size:14px;">{% for label, value in submission.meta %}<tr><th align="left" valign="top">{{ label }}</th><td>{{ value }}</td></tr>{% endfor %}</table>
<h2>Vorschautext</h2><p>{{ submission.excerpt }}</p><h2>Beitragsvorschau</h2><div style="line-height:1.6;">{{ submission.content }}</div>
{% if submission.gallery %}<h2>Zusätzliche Bilder</h2>{% for image in submission.gallery %}<img src="cid:{{ image.cid }}" alt="{{ image.alt }}" width="552" style="display:block;width:100%;max-width:552px;height:auto;border:0;border-radius:6px;margin:12px 0;">{% endfor %}{% endif %}
{% if submission.limited %}<p style="font-size:12px;">Einige Bilder überschreiten die Grenzen der Mailvorschau. Die vollständigen Medien findest du im Beitragseditor.</p>{% endif %}
<p><a href="{{ submission.url }}" style="display:inline-block;padding:12px 20px;background:#164a70;border-radius:6px;color:#fff;text-decoration:none;">{{ submission.action_label|default('Beitrag prüfen') }}</a></p>
<p style="font-size:12px;">Anmeldung und die normalen Beitragsrechte sind erforderlich. Galerien werden als statische Bilder gezeigt. Interaktive Elemente prüfst du im Beitragseditor.</p>
<p style="font-size:12px;word-break:break-all;">{{ submission.url }}</p>
<p style="margin-top:24px;border-top:1px solid #dae2e8;padding-top:12px;font-size:11px;line-height:1.6;color:#526777;">Erstellt mit AI Beitragseinreichung<br>Powered by <a href="https://jan-erbert.de" style="color:#526777;text-decoration:none;">Jan Erbert</a></p></td></tr></table></td></tr></table></body></html>
{% else %}
{{ body|default(message.body) }}
{% endif %}
